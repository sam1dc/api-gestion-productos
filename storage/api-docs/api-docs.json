{
    "openapi": "3.0.0",
    "info": {
        "title": "API Gestión de Productos",
        "description": "API RESTful para la gestión de productos con soporte para múltiples divisas. Desarrollada con Laravel 12 bajo los principios SOLID.\n\n### Divisas Disponibles en el Sistema\nAl registrar productos o precios adicionales, el campo `currency_id` hace referencia a la tabla de divisas:\n* **1** - `USD` ($ - Dólar Estadounidense, tasa base 1.0)\n* **2** - `EUR` (€ - Euro, tasa 0.921)\n* **3** - `GBP` (£ - Libra Esterlina, tasa 0.793)\n* **4** - `MXN` ($ - Peso Mexicano, tasa 17.2)\n* **5** - `COP` ($ - Peso Colombiano, tasa 3950.0)\n* **6** - `BRL` (R$ - Real Brasileño, tasa 4.97)\n\n### Modelo de Producto\n* `name`: Nombre del producto (requerido, máx. 255 car.)\n* `description`: Descripción detallada (opcional)\n* `price`: Precio en la divisa base indicada por `currency_id` (requerido, numérico >= 0)\n* `currency_id`: ID de la divisa base (requerido, debe existir en la tabla currencies)\n* `tax_cost`: Costo de impuestos (opcional, numérico >= 0, default 0)\n* `manufacturing_cost`: Costo de fabricación (opcional, numérico >= 0, default 0)",
        "contact": {
            "name": "Equipo de Desarrollo",
            "email": "soporte@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Servidor de la API (Local o Producción)"
        }
    ],
    "paths": {
        "/api/currencies": {
            "get": {
                "tags": [
                    "Divisas"
                ],
                "summary": "Listar todas las divisas disponibles",
                "description": "Retorna el catálogo de divisas registradas en el sistema con su código, símbolo y tasa de cambio respecto a la divisa base (USD).",
                "operationId": "23e8cf721bca47bcc3bb8bfb6a3b39d9",
                "responses": {
                    "200": {
                        "description": "Lista de divisas disponibles",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CurrencyResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Listar todos los productos",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número de página a consultar (por defecto: 1)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Número de resultados por página (por defecto: 15)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada de productos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ProductResource"
                                            }
                                        },
                                        "links": {
                                            "type": "object"
                                        },
                                        "meta": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Productos"
                ],
                "summary": "Crear un nuevo producto",
                "operationId": "785644b7d7dd38af4b51dafd0fbc1b6d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "price",
                                    "currency_id"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Nombre descriptivo del producto (Obligatorio, máx. 255 car.)",
                                        "type": "string",
                                        "example": "Laptop Pro X2"
                                    },
                                    "description": {
                                        "description": "Descripción detallada de especificaciones y características (Opcional)",
                                        "type": "string",
                                        "example": "Laptop de alto rendimiento con 32GB RAM y 1TB SSD"
                                    },
                                    "price": {
                                        "description": "Precio de venta en la divisa base indicada por currency_id (Obligatorio, >= 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 999.99
                                    },
                                    "currency_id": {
                                        "description": "ID de la divisa base (Obligatorio, debe existir en la tabla currencies). Opciones disponibles: 1=USD ($), 2=EUR (€), 3=GBP (£), 4=MXN ($), 5=COP ($), 6=BRL (R$)",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "tax_cost": {
                                        "description": "Costo de impuestos aplicable al producto en la divisa base (Opcional, >= 0, default 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 150
                                    },
                                    "manufacturing_cost": {
                                        "description": "Costo directo de fabricación del producto en la divisa base (Opcional, >= 0, default 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 300
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Producto creado exitosamente."
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/ProductResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
        "/api/products/{id}": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Obtener un producto por ID",
                "operationId": "c87fb2e4d617e7b36c712cad358acdb8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos del producto",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/ProductResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Productos"
                ],
                "summary": "Actualizar un producto",
                "operationId": "416e4959a3919547eb609d87e3db9135",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "description": "Nombre del producto",
                                        "type": "string",
                                        "example": "Laptop Pro X2 v2"
                                    },
                                    "description": {
                                        "description": "Descripción detallada",
                                        "type": "string",
                                        "example": "Laptop de alto rendimiento actualizada con 64GB RAM"
                                    },
                                    "price": {
                                        "description": "Precio en la divisa base (>= 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 1099.99
                                    },
                                    "currency_id": {
                                        "description": "ID de la divisa base (1=USD, 2=EUR, 3=GBP, 4=MXN, 5=COP, 6=BRL)",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "tax_cost": {
                                        "description": "Costo de impuestos en divisa base (>= 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 165
                                    },
                                    "manufacturing_cost": {
                                        "description": "Costo de fabricación en divisa base (>= 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 320
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Producto actualizado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/ProductResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Productos"
                ],
                "summary": "Eliminar un producto (soft delete)",
                "operationId": "b49ce9f3cb168b233245548fb4ef36d3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Producto eliminado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Producto eliminado exitosamente."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    }
                }
            }
        },
        "/api/products/{id}/prices": {
            "get": {
                "tags": [
                    "Precios de Productos"
                ],
                "summary": "Obtener precios de un producto en diferentes divisas",
                "operationId": "7e8ebe841bb187f10c5df1847718ccd8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de precios del producto",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ProductPriceResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    }
                }
            },
            "post": {
                "tags": [
                    "Precios de Productos"
                ],
                "summary": "Registrar o actualizar el precio de un producto en una divisa",
                "operationId": "da488364de52de732654a81cc7dec6ba",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "currency_id",
                                    "price"
                                ],
                                "properties": {
                                    "currency_id": {
                                        "description": "ID de la divisa para este precio (Obligatorio). Opciones: 1=USD ($), 2=EUR (€), 3=GBP (£), 4=MXN ($), 5=COP ($), 6=BRL (R$)",
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "price": {
                                        "description": "Precio del producto en la divisa especificada (Obligatorio, >= 0)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 849.99
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Precio registrado o actualizado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/ProductPriceResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CurrencyResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "USD"
                    },
                    "symbol": {
                        "type": "string",
                        "example": "$"
                    },
                    "exchange_rate": {
                        "type": "number",
                        "format": "float",
                        "example": 1
                    }
                },
                "type": "object"
            },
            "ProductPriceResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "product_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 19.99
                    },
                    "currency": {
                        "$ref": "#/components/schemas/CurrencyResource"
                    }
                },
                "type": "object"
            },
            "ProductResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Laptop Pro X"
                    },
                    "description": {
                        "type": "string",
                        "example": "Laptop de alta gama"
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 999.99
                    },
                    "tax_cost": {
                        "type": "number",
                        "format": "float",
                        "example": 150
                    },
                    "manufacturing_cost": {
                        "type": "number",
                        "format": "float",
                        "example": 300
                    },
                    "currency": {
                        "$ref": "#/components/schemas/CurrencyResource"
                    },
                    "prices": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductPriceResource"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Divisas",
            "description": "Divisas"
        },
        {
            "name": "Productos",
            "description": "Productos"
        },
        {
            "name": "Precios de Productos",
            "description": "Precios de Productos"
        }
    ]
}